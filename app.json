{
  "expo": {
    "name": "Code Crush",
    "slug": "code-crush",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "codecrush",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.codecrush.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "revenueCatAndroidKey": "YOUR_REVENUECAT_ANDROID_PUBLIC_SDK_KEY",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "afeff52b-37cf-43eb-adca-50a0ec4189cf"
      }
    },
    "ios": {
      "bundleIdentifier": "com.codecrush.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
